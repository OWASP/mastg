          "args": ["int", "java.security.Key"]
        }
      ]
    },
    {
      "class": "javax.crypto.Cipher",
      "methods": [
        "doFinal"
      ]
    },
    {
      "class": "java.security.KeyStore",
      "method": "getKey",
      "overloads": [
        {
          "args": ["java.lang.String", "[C"]
        }
      ]
    }
  ]
}
